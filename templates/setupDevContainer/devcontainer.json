{
	"name": "{{name}}",
	"dockerComposeFile": "docker-compose.yml",
	"service": "app",
	"workspaceFolder": "/workspaces/project/backend",

	"customizations": {
		"vscode": {
			"extensions": [
				"ms-azuretools.vscode-docker",
				"esbenp.prettier-vscode",
				"dbaeumer.vscode-eslint",
				"github.github-vscode-theme",
				"henriiik.vscode-sort",
				"karunamurti.haml",
				"iciclesoft.workspacesort",
				"howardzuo.vscode-git-tags",
				"shakram02.bash-beautify",
				"rogalmic.bash-debug",
				"redhat.vscode-yaml",
				"funkyremi.vscode-google-translate",
				"mohd-akram.vscode-html-format",
				"lewisardern.semgrep-snippets",
				"eamodio.gitlens",
				"aliariff.vscode-erb-beautify",
				"GrapeCity.gc-excelviewer",
				"GitHub.copilot",
				"GitHub.copilot-chat",
				"jnbt.vscode-rufo",
				"anweber.vscode-httpyac",
				"mhutchie.git-graph",
				"gabrieletassoni.thecore",
				"Shopify.ruby-lsp",
				"Anthropic.claude-code"
			],
			"settings": {
				"rubyLsp.rubyVersionManager": { "identifier": "none" },
				"rubyLsp.formatter": "rubocop_internal",
				"editor.formatOnSave": true,
				"[ruby]": {
					"editor.defaultFormatter": "Shopify.ruby-lsp",
					"editor.formatOnSave": true
				},
				"files.associations": {
					"Gemfile.base": "gemfile",
					"Gemfile.lock": "gemfile"
				}
			}
		}
	},
	"features": {
		"ghcr.io/devcontainers/features/node:1": { "version": "lts" },
		"ghcr.io/devcontainers/features/github-cli:1": {},
		"ghcr.io/SrzStephen/devcontainer-features/gitlab-cli:1": {},
		"ghcr.io/devcontainers/features/git-lfs:1": {},
		"ghcr.io/devcontainers/features/python:1": {},
		"ghcr.io/devcontainers-extra/features/claude-code:2": {},
		"ghcr.io/devcontainers-extra/features/apt-packages:1": { "packages": "graphviz" }
	},

	"postCreateCommand": "sudo chown -R vscode:vscode /usr/local/bundle && bundle update --bundler && bundle update && GITHUB_TOKEN=\"${localEnv:GITHUB_TOKEN}\" npx skills update --project --yes && prune-deleted-skills.sh",

	// "mounts": [
	// 	Uncomment only the lines below matching auth/config you already have set up on your host —
	// 	not everyone has glab/bundle/gem/Claude credentials in place, so nothing is mounted by default.
	// 	// Requires: glab CLI already authenticated on the host (~/.config/glab-cli)
	// 	"source=${localEnv:HOME}/.config/glab-cli,target=/home/vscode/.config/glab-cli,type=bind",
	// 	// Requires: Bundler config already set up on the host (~/.bundle), e.g. credentials for private gem sources
	// 	"source=${localEnv:HOME}/.bundle,target=/home/vscode/.bundle,type=bind",
	// 	// Requires: RubyGems credentials already set up on the host (~/.gem), e.g. for pushing gems
	// 	"source=${localEnv:HOME}/.gem,target=/home/vscode/.gem,type=bind",
	// 	// Requires: Claude Code config already present on the host (~/.claude)
	// 	"source=${localEnv:HOME}/.claude,target=/home/vscode/.claude,type=bind",
	// 	// Requires: Claude Code already authenticated on the host (~/.claude.json)
	// 	"source=${localEnv:HOME}/.claude.json,target=/home/vscode/.claude.json,type=bind"
	// ],

	"remoteUser": "vscode"
}
